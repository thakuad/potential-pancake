# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). The anon key is safe to expose to browsers:
# Row Level Security governs all data access, and messages are
# end-to-end encrypted before they ever reach Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
